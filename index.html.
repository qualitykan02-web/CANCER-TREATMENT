 mkc('c1',{type:'line',data:{labels:Y.map(yr),datasets:[...T3.map((t,i)=>({label:NM[t]+' '+LM[t],data:G[i].map(g=>+g.pct.toFixed(2)),borderColor:SC[i],backgroundColor:SC[i],borderWidth:3,tension:.2,pointRadius:7,lbl:(j,v)=>v.toFixed(1)+'%'})),lines(4,70,'เป้า 70% (ผ่าตัด/เคมีบำบัด)','#8a97a6'),lines(4,60,'เป้า 60% (รังสีรักษา)','#b9c3cf')]},
  options:{plugins:{legend:{position:'bottom'},tooltip:{callbacks:{label:c=>{const g=G[c.datasetIndex]?.[c.dataIndex];return g?[`${c.dataset.label}: ${pc(g.pct)}`,`วางแผน ${g.p} · ทันเวลา ${g.d} ราย`]:c.dataset.label}}}},scales:{y:{min:40,max:100,ticks:{callback:v=>v+'%'}},x:{grid:{display:false}}}}});
 const s1=T3.map(t=>{const a=get(66,t).pct,b=get(69,t).pct;return`${NM[t]}: ${b>=a?'ดีขึ้น':'แย่ลง'} จาก ${a.toFixed(1)}% (2566) เป็น ${b.toFixed(1)}% (2569) — ${b>=TG[t]?'สูงกว่า':'ต่ำกว่า'}เป้าหมาย ${TG[t]}% ในไฟล์`});
 $('#s1').innerHTML=s1.map(x=>`<li>${x}</li>`).join('');
 $('#t1').innerHTML='<tr><th>ปีงบประมาณ</th>'+T3.map(t=>`<th>${NM[t]}<br><small>ทันเวลา/วางแผน</small></th>`).join('')+'</tr>'+Y.map(y=>`<tr><td>${yr(y)}</td>${T3.map(t=>{const g=get(y,t);return`<td><b class="bd ${cl(g.pct,t)}">${pc(g.pct)}</b><br><small>${g.d}/${g.p}</small></td>`}).join('')}</tr>`).join('');
 const Mg=T3.map(t=>MO.map(m=>get(69,t,null,m)));
 mkc('c0',{type:'line',data:{labels:MO.map(m=>m+' 69'),datasets:T3.map((t,i)=>({label:NM[t],data:Mg[i].map(g=>+g.pct.toFixed(2)),borderColor:SC[i],backgroundColor:SC[i],borderWidth:3,tension:.2,pointRadius:6,lbl:(j,v)=>v.toFixed(1)+'%'}))},options:{plugins:{legend:{position:'bottom'},tooltip:{callbacks:{label:c=>{const g=Mg[c.datasetIndex][c.dataIndex];return`${c.dataset.label}: ${pc(g.pct)} (${g.d}/${g.p} ราย)`}}}},scales:{y:{min:50,max:100,ticks:{callback:v=>v+'%'}},x:{grid:{display:false}}}}});
 hosp()}
function hosp(){const y=+$('#yy').value,t=$('#tt').value,mon=y===69?$('#mm').value:null;$('#mw').style.display=y===69?'':'none';
 const tg=get(y,t,null,mon),lab=y===69?`ถึงสิ้นเดือน ${mon} 2569`:'ทั้งปีงบประมาณ';
 if(t==='r'){mkc('c2',{type:'bar',data:{labels:[],datasets:[]},options:{}},'รังสีรักษา: ไฟล์ระบุเป็นข้อมูลภาพรวมทั้งจังหวัด ไม่แยกรายโรงพยาบาล');$('#t2').innerHTML='';
  $('#s2').innerHTML=`<li>ระดับจังหวัด ปี ${yr(y)} ${lab}: ทันเวลา ${tg.d} จาก ${tg.p} ราย (${pc(tg.pct)}) เป้าหมาย ≥${TG.r}%</li>`;return}
 const L=U.map(u=>({u,g:get(y,t,u,mon)})).filter(x=>!x.g.na),A=L.filter(x=>x.g.p>0).sort((a,b)=>b.g.pct-a.g.pct),Z=L.filter(x=>x.g.p===0);
 $('#c2').parentElement.style.setProperty('--ch',Math.max(260,A.length*52+40)+'px');
 mkc('c2',{type:'bar',data:{labels:A.map(x=>lb(x.u)),datasets:[{data:A.map(x=>+x.g.pct.toFixed(2)),backgroundColor:A.map(x=>cc(x.g.pct,t)),lbl:(j,v)=>v.toFixed(1)+'% ('+A[j].g.d+'/'+A[j].g.p+' ราย)'}]},options:{indexAxis:'y',plugins:{legend:{display:false}},scales:{x:{min:0,max:125,ticks:{callback:v=>v<=100?v+'%':''}},y:{grid:{display:false}}}}},A.length?'':'ไม่มีผู้ป่วยวางแผนรักษา');
 const big=A.filter(x=>x.g.p>=10),s=[`ปี ${yr(y)} ${lab} · เป้าหมาย ≥${TG[t]}% · รวมจังหวัด ${pc(tg.pct)} (${tg.d}/${tg.p} ราย)`];
 if(big.length>1)s.push(`สูงสุด ${lb(big[0].u)} ${big[0].g.pct.toFixed(1)}% · ต่ำสุด ${lb(big[big.length-1].u)} ${big[big.length-1].g.pct.toFixed(1)}% (เทียบเฉพาะหน่วยที่วางแผน ≥10 ราย)`);
 const lo=A.filter(x=>x.g.pct<TG[t]);if(lo.length)s.push(`ต่ำกว่าเป้า ${TG[t]}%: ${lo.map(x=>lb(x.u)+' '+x.g.pct.toFixed(1)+'% (n='+x.g.p+')').join(', ')}`);
 if(A.some(x=>x.g.p<10))s.push('หน่วยที่มีผู้ป่วยน้อยกว่า 10 ราย ร้อยละอาจผันผวนมาก (เช่น 1/1 = 100%) ควรอ่านร่วมกับจำนวนราย');
 if(Z.length)s.push(`ไม่มีผู้ป่วยวางแผนรักษา (ค่า 0 จึงคำนวณร้อยละไม่ได้): ${Z.map(x=>x.u).join(', ')}`);
 if(y<69)s.push('ปี 2566–2568 ไฟล์มีข้อมูลเฉพาะ 6 โรงพยาบาล');
 $('#s2').innerHTML=s.map(x=>`<li>${x}</li>`).join('');
 $('#t2').innerHTML='<tr><th>โรงพยาบาล / หน่วยบริการ</th><th>วางแผนรักษา (ราย)</th><th>ทันเวลา (ราย)</th><th>ร้อยละ</th></tr>'+[...A,...Z].map(x=>`<tr><td>${lb(x.u)}</td><td>${x.g.p}</td><td>${x.g.d}</td><td><span class="bd ${cl(x.g.pct,t)}">${pc(x.g.pct)}</span></td></tr>`).join('')+`<tr><td><b>รวมจังหวัด</b></td><td><b>${tg.p}</b></td><td><b>${tg.d}</b></td><td><span class="bd ${cl(tg.pct,t)}">${pc(tg.pct)}</span></td></tr>`}
$('#yy').innerHTML=Y.map(y=>`<option value="${y}">ปี ${yr(y)}</option>`).join('');$('#yy').value=69;
$('#tt').innerHTML=T3.map(t=>`<option value="${t}">${NM[t]} ${LM[t]}</option>`).join('');
$('#mm').innerHTML=MO.map(m=>`<option value="${m}">${m} 2569</option>`).join('');$('#mm').value='ก.ย.';
$('#yy').onchange=$('#tt').onchange=$('#mm').onchange=hosp;$('#pr').onclick=()=>window.print();
$('#sws').onclick=e=>{const b=e.target.closest('.sw');if(b)theme(b.dataset.k)};
$('#ph').onchange=e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{const h=$('#hero');h.style.setProperty('--img','url("'+r.result+'")');h.classList.add('ph')};r.readAsDataURL(f)};
$('#phr').onclick=()=>{$('#hero').classList.remove('ph');$('#ph').value=''};
try{theme('Fresh Healthcare');draw()}catch(e){$('#dqs').textContent='แสดงผลกราฟไม่สำเร็จ: '+e.message}
</script></body></html>
